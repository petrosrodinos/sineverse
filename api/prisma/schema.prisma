// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthRole {
  USER
  ADMIN
  SUPER_ADMIN
  SUPPORT
}

enum ProjectStatus {
  DRAFT
  ENRICHED
  SCENES_GENERATED
  PROMPTS_GENERATED
  VIDEOS_GENERATING
  COMPLETED
}

enum VideoStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum VideoProvider {
  VEO3
  RUNWAY
  PIKA
  STABILITY
}

enum DocumentType {
  VIDEO
  IMAGE
  AUDIO
  DOCUMENT
  THUMBNAIL
}


model User {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  email      String   @unique
  phone      String?  @unique
  password   String
  role       AuthRole
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  projects   Project[]
  final_projects FinalProject[]

  @@index([email])
  @@index([phone])
  @@index([uuid])
  @@map("users")
}

model Project {
  id              Int      @id @default(autoincrement())
  uuid            String   @unique @default(uuid())
  user_uuid       String
  title           String?
  original_concept String   @db.Text
  enriched_concept String?  @db.Text
  genre           String?
  tone            String?
  status          ProjectStatus @default(DRAFT)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user            User @relation(fields: [user_uuid],references: [uuid],onDelete: Cascade)
  scenes          Scene[]
  final_projects    FinalProject[]

  @@index([uuid])
  @@index([user_uuid])
  @@map("projects")
}

model Scene {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid())
  project_uuid  String
  title         String?
  description   String?  @db.Text
  order    Int
  duration_sec   Int?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  project       Project @relation(fields: [project_uuid],references: [uuid],onDelete: Cascade)
  prompt_variations SceneVariation[]

  @@index([uuid])
  @@index([project_uuid])
  @@unique([project_uuid, order])
  @@map("scenes")
}

model SceneVariation {
  id              Int      @id @default(autoincrement())
  uuid            String   @unique @default(uuid())
  scene_uuid      String
  prompt_image_uuid String?

  // Creative direction
  style           String?  // cinematic, anime, noir, hyperrealistic
  mood            String?  // dark, uplifting, tense, dreamy
  genre_style     String?  // sci-fi, western, horror, fantasy

  // Camera & composition
  camera_style    String?  // handheld, drone, steadicam
  shot_type       String?  // close-up, wide shot, over-the-shoulder
  camera_movement String?  // slow pan, fast tracking, dolly in
  lens_type       String?  // 35mm, 50mm, anamorphic
  depth_of_field  String?  // shallow, deep

  // Lighting & color
  lighting        String?  // golden hour, neon, low-key
  color_grade     String?  // teal-orange, desaturated, vibrant
  time_of_day     String?  // sunrise, night, sunset

  // Output format
  aspect_ratio    String?  // 16:9, 9:16, 1:1, 2.35:1
  resolution      String?  // 720p, 1080p, 4K
  fps             Int?
  duration_sec    Int?

  // AI generation control
  ai_model        VideoProvider?
  seed            Int?
  creativity      Float?   // temperature-like control
  motion_strength Float?   // how dynamic the scene is
  guidance_scale  Float?   // prompt adherence

  // Audio style (future proof)
  audio_style     String?  // orchestral, ambient, cinematic trailer
  include_sound   Boolean  @default(false)

  prompt_text     String   @db.Text
  negative_prompt String?  @db.Text

  selected        Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  scene           Scene @relation(fields: [scene_uuid],references: [uuid],onDelete: Cascade)
  prompt_image      Document? @relation("SceneVariationImage", fields: [prompt_image_uuid],references: [uuid],onDelete: Cascade)
  videos          SceneVideo[]

  @@index([uuid])
  @@index([scene_uuid])
  @@map("scene_variations")
}

model SceneVideo {
  id                     Int      @id @default(autoincrement())
  uuid                   String   @unique @default(uuid())
  prompt_variation_uuid  String
  provider               VideoProvider
  selected               Boolean @default(false)
  provider_job_id          String?
  video_uuid               String?
  duration_sec            Int?
  resolution             String?
  status                 VideoStatus @default(PENDING)
  error_message           String?     @db.Text
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  prompt_variation        SceneVariation @relation(fields: [prompt_variation_uuid],references: [uuid],onDelete: Cascade)
  video                   Document? @relation("SceneVideo", fields: [video_uuid],references: [uuid],onDelete: Cascade)

  @@index([uuid])
  @@index([prompt_variation_uuid])
  @@unique([prompt_variation_uuid, selected])
  @@map("scene_videos")
}

model FinalProject {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid())
  user_uuid     String
  project_uuid  String
  title         String?
  duration_sec   Int?
  video_uuid    String?
  thumbnail_uuid String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user          User @relation(fields: [user_uuid],references: [uuid],onDelete: Cascade)
  project       Project @relation(fields: [project_uuid],references: [uuid],onDelete: Cascade)
  video         Document? @relation("FinalProjectVideo", fields: [video_uuid],references: [uuid],onDelete: Cascade)
  thumbnail     Document? @relation("FinalProjectThumbnail", fields: [thumbnail_uuid],references: [uuid],onDelete: Cascade)

  @@index([uuid])
  @@index([project_uuid])
  @@map("final_projects")
}

model Document {
  id                 Int           @id @default(autoincrement())
  uuid               String        @unique @default(uuid())
  filename           String
  mimetype           String
  size               Int
  url                String
  path               String
  type               DocumentType  @default(DOCUMENT)
  order              Int      @default(0)
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  scene_videos SceneVideo[] @relation("SceneVideo")
  prompt_images SceneVariation[] @relation("SceneVariationImage")
  final_project_videos FinalProject[] @relation("FinalProjectVideo")
  final_project_thumbnails FinalProject[] @relation("FinalProjectThumbnail")

  @@index([uuid])
  @@index([type])
  @@index([order])
  @@map("documents")
}

