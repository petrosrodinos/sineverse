generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthRole {
  USER
  ADMIN
  SUPER_ADMIN
  SUPPORT
}

enum AssetStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DocumentType {
  VIDEO
  IMAGE
  AUDIO
  THUMBNAIL
  CAPTION
  VOICEOVER
  MUSIC
  DOCUMENT
}

enum AssetRole {
  PROMPT_IMAGE
  GENERATED_IMAGE
  GENERATED_VIDEO
  UPSCALED_VIDEO
  GENERATED_THUMBNAIL
  GENERATED_VOICEOVER
  GENERATED_MUSIC
  GENERATED_CAPTION
}

model User {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  email      String   @unique
  phone      String?  @unique
  full_name  String
  password   String
  role       AuthRole
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  projects         Project[]
  scenes           Scene[]
  scene_variations SceneVariation[]
  project_assets   ProjectAsset[]
  final_projects   FinalProject[]

  @@index([email])
  @@index([phone])
  @@index([uuid])
  @@map("users")
}

model Project {
  id               Int      @id @default(autoincrement())
  uuid             String   @unique @default(uuid())
  user_uuid        String
  title            String
  original_concept String   @db.Text
  enriched_concept String?  @db.Text
  genres           Json?
  tones            Json?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user           User           @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)
  scenes         Scene[]
  project_assets ProjectAsset[]
  final_projects FinalProject[]

  @@index([uuid])
  @@index([user_uuid])
  @@map("projects")
}

model Scene {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  user_uuid    String
  project_uuid String
  title        String
  description  String?  @db.Text
  order        Int
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user             User             @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)
  project          Project          @relation(fields: [project_uuid], references: [uuid], onDelete: Cascade)
  scene_variations SceneVariation[]
  project_assets   ProjectAsset[]

  @@unique([project_uuid, order])
  @@index([uuid])
  @@index([project_uuid])
  @@map("scenes")
}

model SceneVariation {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  user_uuid    String
  scene_uuid   String
  title        String
  selected     Boolean  @default(false)
  ai_generated Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user           User           @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)
  scene          Scene          @relation(fields: [scene_uuid], references: [uuid], onDelete: Cascade)
  project_assets ProjectAsset[]

  @@index([uuid])
  @@index([user_uuid])
  @@index([scene_uuid])
  @@map("scene_variations")
}

model ProjectAsset {
  id                   Int          @id @default(autoincrement())
  uuid                 String       @unique @default(uuid())
  user_uuid            String
  project_uuid         String
  scene_uuid           String?
  scene_variation_uuid String?
  provider_job_id      String?
  document_uuid        String?
  selected             Boolean      @default(false)
  status               AssetStatus  @default(PENDING)
  type                 DocumentType @default(VIDEO)
  role                 AssetRole    @default(GENERATED_VIDEO)
  error_message        String?      @db.Text
  metadata             Json?
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt

  user            User            @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)
  project         Project         @relation(fields: [project_uuid], references: [uuid], onDelete: Cascade)
  scene           Scene?          @relation(fields: [scene_uuid], references: [uuid], onDelete: Cascade)
  scene_variation SceneVariation? @relation(fields: [scene_variation_uuid], references: [uuid], onDelete: Cascade)
  document        Document?       @relation("ProjectAsset", fields: [document_uuid], references: [uuid], onDelete: Cascade)

  @@index([uuid])
  @@index([user_uuid])
  @@index([project_uuid])
  @@index([scene_uuid])
  @@index([scene_variation_uuid])
  @@map("project_assets")
}

model FinalProject {
  id             Int      @id @default(autoincrement())
  uuid           String   @unique @default(uuid())
  user_uuid      String
  project_uuid   String
  title          String?
  duration_sec   Int?
  video_uuid     String?
  thumbnail_uuid String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user      User      @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)
  project   Project   @relation(fields: [project_uuid], references: [uuid], onDelete: Cascade)
  video     Document? @relation("FinalProjectVideo", fields: [video_uuid], references: [uuid], onDelete: Cascade)
  thumbnail Document? @relation("FinalProjectThumbnail", fields: [thumbnail_uuid], references: [uuid], onDelete: Cascade)

  @@index([uuid])
  @@index([user_uuid])
  @@index([project_uuid])
  @@map("final_projects")
}

model Document {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  filename   String
  mimetype   String
  size       Int
  url        String
  path       String
  order      Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  final_project_videos     FinalProject[] @relation("FinalProjectVideo")
  final_project_thumbnails FinalProject[] @relation("FinalProjectThumbnail")
  project_assets           ProjectAsset[] @relation("ProjectAsset")

  @@index([uuid])
  @@index([order])
  @@map("documents")
}
