generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthRole {
  USER
  ADMIN
  SUPER_ADMIN
  SUPPORT
}

enum AssetStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DocumentType {
  VIDEO
  IMAGE
  AUDIO
  THUMBNAIL
  CAPTION
  VOICEOVER
  MUSIC
  DOCUMENT
}

enum AssetRole {
  PROMPT_IMAGE
  GENERATED_IMAGE
  GENERATED_VIDEO
  UPSCALED_VIDEO
  GENERATED_THUMBNAIL
  GENERATED_VOICEOVER
  GENERATED_MUSIC
  GENERATED_CAPTION
}

enum ProjectType {
  FILM
  ESTATE
}

enum CreditLedgerType {
  PURCHASE
  USAGE
  ADJUSTMENT
  REFUND
}

enum CreditPurchaseStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
}

enum TimelineTrackType {
  VIDEO
  AUDIO
  VOICEOVER
  MUSIC
  CAPTION
}

enum TimelineTransitionType {
  FADE
  CROSSFADE
  DISSOLVE
  SLIDE_LEFT
  SLIDE_RIGHT
  ZOOM
}

model User {
  id              Int      @id @default(autoincrement())
  uuid            String   @unique @default(uuid())
  email           String   @unique
  phone           String?  @unique
  full_name       String
  password        String
  role            AuthRole
  credits_balance Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  projects              Project[]
  scenes                Scene[]
  scene_variations      SceneVariation[]
  project_assets        ProjectAsset[]
  final_projects        FinalProject[]
  credit_purchases      CreditPurchase[]
  credit_ledger_entries CreditLedgerEntry[]

  @@index([email])
  @@index([phone])
  @@index([uuid])
  @@map("users")
}

model Project {
  id               Int         @id @default(autoincrement())
  uuid             String      @unique @default(uuid())
  user_uuid        String
  title            String
  type             ProjectType @default(FILM)
  original_concept String?     @db.Text
  enriched_concept String?     @db.Text
  genres           Json?
  tones            Json?
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  user           User           @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)
  scenes         Scene[]
  project_assets ProjectAsset[]
  final_projects FinalProject[]

  @@index([uuid])
  @@index([user_uuid])
  @@map("projects")
}

model Scene {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  user_uuid    String
  project_uuid String
  title        String
  description  String?  @db.Text
  order        Int
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user             User             @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)
  project          Project          @relation(fields: [project_uuid], references: [uuid], onDelete: Cascade)
  scene_variations SceneVariation[]
  project_assets   ProjectAsset[]

  @@unique([project_uuid, order])
  @@index([uuid])
  @@index([project_uuid])
  @@map("scenes")
}

model SceneVariation {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  user_uuid    String
  scene_uuid   String
  title        String
  selected     Boolean  @default(false)
  ai_generated Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user           User           @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)
  scene          Scene          @relation(fields: [scene_uuid], references: [uuid], onDelete: Cascade)
  project_assets ProjectAsset[]

  @@index([uuid])
  @@index([user_uuid])
  @@index([scene_uuid])
  @@map("scene_variations")
}

model ProjectAsset {
  id                   Int          @id @default(autoincrement())
  uuid                 String       @unique @default(uuid())
  user_uuid            String
  project_uuid         String
  scene_uuid           String?
  scene_variation_uuid String?
  provider_job_id      String?
  document_uuid        String?
  selected             Boolean      @default(false)
  status               AssetStatus  @default(PENDING)
  type                 DocumentType @default(VIDEO)
  role                 AssetRole    @default(GENERATED_VIDEO)
  error_message        String?      @db.Text
  metadata             Json?
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt

  user            User            @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)
  project         Project         @relation(fields: [project_uuid], references: [uuid], onDelete: Cascade)
  scene           Scene?          @relation(fields: [scene_uuid], references: [uuid], onDelete: Cascade)
  scene_variation SceneVariation? @relation(fields: [scene_variation_uuid], references: [uuid], onDelete: Cascade)
  document        Document?       @relation("ProjectAsset", fields: [document_uuid], references: [uuid], onDelete: Cascade)

  prompt_images  ProjectAsset[] @relation("ProjectAssetPromptImages")
  video_assets   ProjectAsset[] @relation("ProjectAssetPromptImages")
  timeline_clips TimelineClip[] @relation("ProjectAssetTimelineClips")

  @@index([uuid])
  @@index([user_uuid])
  @@index([project_uuid])
  @@index([scene_uuid])
  @@index([scene_variation_uuid])
  @@map("project_assets")
}

model FinalProject {
  id             Int      @id @default(autoincrement())
  uuid           String   @unique @default(uuid())
  user_uuid      String
  project_uuid   String
  title          String?
  duration_sec   Int?
  video_uuid     String?
  thumbnail_uuid String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user           User            @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)
  project        Project         @relation(fields: [project_uuid], references: [uuid], onDelete: Cascade)
  video          Document?       @relation("FinalProjectVideo", fields: [video_uuid], references: [uuid], onDelete: Cascade)
  thumbnail      Document?       @relation("FinalProjectThumbnail", fields: [thumbnail_uuid], references: [uuid], onDelete: Cascade)
  tracks         TimelineTrack[]
  timeline_music TimelineMusic[]

  @@index([uuid])
  @@index([user_uuid])
  @@index([project_uuid])
  @@map("final_projects")
}

model TimelineTrack {
  id                 Int               @id @default(autoincrement())
  uuid               String            @unique @default(uuid())
  final_project_uuid String
  type               TimelineTrackType
  order              Int
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt

  final_project FinalProject   @relation(fields: [final_project_uuid], references: [uuid], onDelete: Cascade)
  clips         TimelineClip[]

  @@unique([final_project_uuid, order])
  @@index([uuid])
  @@map("timeline_tracks")
}

model TimelineClip {
  id                  Int      @id @default(autoincrement())
  uuid                String   @unique @default(uuid())
  track_uuid          String
  project_asset_uuid  String?
  start_sec           Float
  end_sec             Float
  trim_start          Float?
  trim_end            Float?
  volume              Float?   @default(1.0)
  speed               Float?   @default(1.0)
  transition_in_uuid  String?
  transition_out_uuid String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  track          TimelineTrack       @relation(fields: [track_uuid], references: [uuid], onDelete: Cascade)
  project_asset  ProjectAsset?       @relation("ProjectAssetTimelineClips", fields: [project_asset_uuid], references: [uuid], onDelete: SetNull)
  transition_in  TimelineTransition? @relation("TransitionIn", fields: [transition_in_uuid], references: [uuid])
  transition_out TimelineTransition? @relation("TransitionOut", fields: [transition_out_uuid], references: [uuid])
  captions       TimelineCaption[]

  @@index([uuid])
  @@index([track_uuid])
  @@map("timeline_clips")
}

model TimelineTransition {
  id         Int                    @id @default(autoincrement())
  uuid       String                 @unique @default(uuid())
  type       TimelineTransitionType
  duration   Float
  created_at DateTime               @default(now())
  updated_at DateTime               @updatedAt

  clip_in  TimelineClip[] @relation("TransitionIn")
  clip_out TimelineClip[] @relation("TransitionOut")

  @@index([uuid])
  @@map("timeline_transitions")
}

model TimelineCaption {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  clip_uuid  String
  text       String   @db.Text
  start_sec  Float
  end_sec    Float
  position   Json?
  style      Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  clip TimelineClip @relation(fields: [clip_uuid], references: [uuid], onDelete: Cascade)

  @@index([uuid])
  @@index([clip_uuid])
  @@map("timeline_captions")
}

model TimelineMusic {
  id                 Int      @id @default(autoincrement())
  uuid               String   @unique @default(uuid())
  final_project_uuid String
  audio_uuid         String
  start_sec          Float
  end_sec            Float
  volume             Float?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  final_project FinalProject @relation(fields: [final_project_uuid], references: [uuid], onDelete: Cascade)
  audio         Document     @relation(fields: [audio_uuid], references: [uuid], onDelete: Cascade)

  @@index([uuid])
  @@map("timeline_music")
}

model Document {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  filename   String
  mimetype   String
  size       Int
  url        String
  path       String
  order      Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  final_project_videos     FinalProject[]  @relation("FinalProjectVideo")
  final_project_thumbnails FinalProject[]  @relation("FinalProjectThumbnail")
  project_assets           ProjectAsset[]  @relation("ProjectAsset")
  timeline_music           TimelineMusic[]

  @@index([uuid])
  @@index([order])
  @@map("documents")
}

model CreditPack {
  id                Int      @id @default(autoincrement())
  uuid              String   @unique @default(uuid())
  key               String   @unique
  name              String
  credits_amount    Int
  amount_cents      Int
  currency          String   @default("eur")
  stripe_product_id String?  @unique
  stripe_price_id   String?  @unique
  active            Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  credit_purchases CreditPurchase[]

  @@index([active])
  @@index([key])
  @@map("credit_packs")
}

model CreditPurchase {
  id                       Int                  @id @default(autoincrement())
  uuid                     String               @unique @default(uuid())
  user_uuid                String
  credit_pack_uuid         String
  status                   CreditPurchaseStatus @default(PENDING)
  credits_amount           Int
  amount_cents             Int
  gross_amount_cents       Int?
  stripe_fee_cents         Int?
  net_amount_cents         Int?
  currency                 String               @default("eur")
  stripe_session_id        String?              @unique
  stripe_payment_intent_id String?              @unique
  stripe_charge_id         String?              @unique
  stripe_receipt_url       String?
  metadata                 Json?
  created_at               DateTime             @default(now())
  updated_at               DateTime             @updatedAt

  user           User                @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)
  credit_pack    CreditPack          @relation(fields: [credit_pack_uuid], references: [uuid], onDelete: Restrict)
  ledger_entries CreditLedgerEntry[]

  @@index([user_uuid, created_at])
  @@index([credit_pack_uuid])
  @@index([status])
  @@map("credit_purchases")
}

model CreditLedgerEntry {
  id                         Int              @id @default(autoincrement())
  uuid                       String           @unique @default(uuid())
  user_uuid                  String
  type                       CreditLedgerType
  delta_credits              Int
  balance_after              Int
  project_type               ProjectType?
  source                     String?
  source_ref_uuid            String?
  idempotency_key            String?          @unique
  credit_purchase_uuid       String?
  provider_charge_amount_usd Decimal?         @db.Decimal(12, 6)
  provider_charge_amount     Decimal?         @db.Decimal(12, 6)
  app_fee_rate               Decimal?         @db.Decimal(8, 6)
  app_fee_amount             Decimal?         @db.Decimal(12, 6)
  gross_charge_amount        Decimal?         @db.Decimal(12, 6)
  fx_rate_usd_to_eur         Decimal?         @db.Decimal(12, 6)
  fx_source                  String?
  fx_timestamp               DateTime?
  metadata                   Json?
  created_at                 DateTime         @default(now())
  updated_at                 DateTime         @updatedAt

  user            User            @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)
  credit_purchase CreditPurchase? @relation(fields: [credit_purchase_uuid], references: [uuid], onDelete: SetNull)

  @@index([user_uuid, created_at])
  @@index([type])
  @@index([credit_purchase_uuid])
  @@map("credit_ledger_entries")
}

model CurrencyRateSnapshot {
  id             Int      @id @default(autoincrement())
  base_currency  String
  quote_currency String
  rate           Decimal  @db.Decimal(12, 6)
  source         String
  is_fallback    Boolean  @default(false)
  fetched_at     DateTime @default(now())
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([base_currency, quote_currency, fetched_at])
  @@map("currency_rate_snapshots")
}
